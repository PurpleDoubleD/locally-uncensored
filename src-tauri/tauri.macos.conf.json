{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "app": {
    "windows": [
      {
        "title": "LU",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "bin/lu-llama-server",
      "bin/lu-llama-quantize",
      "bin/lu-llama-cvector-generator"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "locallyuncensored"
        ]
      }
    }
  }
}
