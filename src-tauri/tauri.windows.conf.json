{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Locally Uncensored",
  "app": {
    "windows": [
      {
        "title": "LU",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "bin/lu-llama-server",
      "bin/lu-llama-cvector-generator"
    ],
    "resources": {
      "resources/whisper_server.py": "resources/whisper_server.py",
      "resources/voice_loop/lu_voice_loop/*.py": "resources/voice_loop/lu_voice_loop/",
      "resources/voice_loop/requirements.txt": "resources/voice_loop/requirements.txt",
      "resources/voice_loop/models.json": "resources/voice_loop/models.json",
      "resources/voice_loop/python.json": "resources/voice_loop/python.json",
      "resources/llama/x86_64-pc-windows-msvc/*": "",
      "resources/abliterate/lu_abliterate.py": "resources/abliterate/lu_abliterate.py",
      "resources/abliterate/requirements.txt": "resources/abliterate/requirements.txt",
      "resources/abliterate/constraints.txt": "resources/abliterate/constraints.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "locallyuncensored"
        ]
      }
    }
  }
}
