{
  "name": "locally-uncensored",
  "version": "3.1.2",
  "private": false,
  "description": "The all-in-one local AI studio for your desktop: chat, images, video and a coding agent in one app.",
  "license": "AGPL-3.0-only",
  "author": "purpledoubled",
  "repository": {
    "type": "git",
    "url": "https://github.com/purpledoubled/locally-uncensored.git"
  },
  "keywords": [
    "ai",
    "local",
    "ollama",
    "comfyui",
    "uncensored",
    "private",
    "chat",
    "image-generation",
    "video-generation"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-face-assets.mjs && vite",
    "build": "node scripts/copy-face-assets.mjs && vite build",
    "dev:mobile": "VITE_LU_BUILD_TARGET=mobile vite",
    "build:mobile": "VITE_LU_BUILD_TARGET=mobile vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "cycles": "madge --circular --extensions ts,tsx src",
    "test": "vitest run",
    "test:security-deps": "node --test scripts/security-dependencies.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@pipecat-ai/client-js": "1.16.0",
    "@pipecat-ai/websocket-transport": "1.8.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "three": "0.187.0",
    "uuid": "^13.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "madge": "^8.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@tauri-apps/plugin-updater": {
      "@tauri-apps/api": "$@tauri-apps/api"
    }
  }
}
