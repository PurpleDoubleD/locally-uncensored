 #include "ggml-cuda.h"
@@ -466,6 +469,14 @@ int main(int argc, char ** argv) {
 
     std::cout << "n_total_tokens: " << n_total_tokens << std::endl;
 
+    // LU: with LU_LAYER_NORMS set the tool measures instead of building a
+    // vector: the length of the residual stream after each block, over every
+    // token but the first, for the positive lines. The app takes the median
+    // per block as the unit of a single-neuron slider (the unit neuron
+    // recipes are shared in). The negative lines are not read.
+    const bool lu_norms = getenv("LU_LAYER_NORMS") != nullptr;
+    std::vector<std::vector<float>> lu_norms_by_layer;
+
     for(size_t i = 0; i < ctx_train.positive_entries.size(); ++i) {
