@@ -485,6 +496,23 @@ int main(int argc, char ** argv) {
         success = get_hidden_layers(ctx, t.tokens_pos);
         if (!success) break;
 
+        if (lu_norms) {
+            lu_norms_by_layer.resize(cb_data.v_pos.size());
+            for (size_t il = 0; il < cb_data.v_pos.size(); il++) {
+                const ggml_tensor * h = cb_data.v_pos[il];
+                for (int64_t r = 1; r < h->ne[1]; r++) {
+                    const float * row = (const float *) ((const char *) h->data + r * h->nb[1]);
+                    double sum = 0.0;
+                    for (int64_t j = 0; j < h->ne[0]; j++) {
+                        sum += (double) row[j] * row[j];
+                    }
+                    lu_norms_by_layer[il].push_back((float) std::sqrt(sum));
+                }
+            }
+            cb_data.reset();
+            continue;
+        }
+
         cb_data.is_eval_pos = false;
         success = get_hidden_layers(ctx, t.tokens_neg);
