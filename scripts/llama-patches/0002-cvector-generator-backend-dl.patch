diff --git a/tools/cvector-generator/pca.hpp b/tools/cvector-generator/pca.hpp
index afd3bf6..b629b04 100644
--- a/tools/cvector-generator/pca.hpp
+++ b/tools/cvector-generator/pca.hpp
@@ -16,6 +16,30 @@
 #include <string>
 #include <vector>
 
+// LU: the generator reads and writes its own host F32 tensors with these
+// instead of ggml-cpu's ggml_{get,set}_f32_{1d,nd}, and reaches the CPU
+// backend through the registry, so it builds with GGML_BACKEND_DL as well
+// and runs on the server's dynamically loaded backends (CPU variants, GPU).
+static float lu_get_f32_nd(const struct ggml_tensor * t, int i0, int i1, int i2, int i3) {
+    GGML_ASSERT(t->type == GGML_TYPE_F32);
+    return *(const float *) ((const char *) t->data + i0*t->nb[0] + i1*t->nb[1] + i2*t->nb[2] + i3*t->nb[3]);
+}
+
+static void lu_set_f32_nd(const struct ggml_tensor * t, int i0, int i1, int i2, int i3, float value) {
+    GGML_ASSERT(t->type == GGML_TYPE_F32);
+    *(float *) ((char *) t->data + i0*t->nb[0] + i1*t->nb[1] + i2*t->nb[2] + i3*t->nb[3]) = value;
+}
+
+static float lu_get_f32_1d(const struct ggml_tensor * t, int i) {
+    GGML_ASSERT(t->type == GGML_TYPE_F32 && ggml_is_contiguous(t));
+    return ((const float *) t->data)[i];
+}
+
+static void lu_set_f32_1d(const struct ggml_tensor * t, int i, float value) {
+    GGML_ASSERT(t->type == GGML_TYPE_F32 && ggml_is_contiguous(t));
+    ((float *) t->data)[i] = value;
+}
+
 #define DEBUG_POS 5
 
